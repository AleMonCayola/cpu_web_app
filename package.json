{
  "name": "cpu_app",
  "version": "1.0.0",
  "description": "Aplicación de escritorio CPU App",
  "main": "src/main/main.js",
  "author": "Alejandro Montano Cayola",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "electron-builder"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3"
  },
  "overrides": {
    "@noble/hashes": "1.3.3"
  },
  "build": {
    "appId": "com.cpuapp.app",
    "productName": "CPU APP",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
 }
}
